# setup scripts generate secure values. Do not commit .env.
POSTGRES_PASSWORD=replace-with-generated-hex
API_TOKEN=replace-with-generated-token-at-least-24-characters
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
OLLAMA_CONTEXT=8192
# Default: extract template locally from measured geometry (no visual-model tokens)
TEMPLATE_AI_REFINEMENT=false
# Log token estimates / Ollama prompt_eval_count without logging resume content
AI_DEBUG_TOKENS=false
# Use the actual published port of your existing Job-Watcher API:
JOB_WATCHER_BASE_URL=http://host.docker.internal:3000/api
JOB_WATCHER_TOKEN=
# Optional; leave blank for public repositories (GitHub rate limits apply)
GITHUB_TOKEN=
# Change to 0.0.0.0 only if you want access from your LAN
WEB_BIND=127.0.0.1
